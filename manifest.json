{
  "manifest_version": 3,
  "name": "Threads 小編工具",
  "version": "1.0.1",
  "description": "給 Threads 小編用：貼文下方顯示回覆率、轉發率、分享率，一鍵收錄文案成文字檔，高流量貼文與趨勢話題自動記錄，影片下載。資料只存本機。與 Meta 無關。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Threads 小編工具",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.threads.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.threads.com/*"
      ],
      "js": [
        "lib.js",
        "page-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.threads.com/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
